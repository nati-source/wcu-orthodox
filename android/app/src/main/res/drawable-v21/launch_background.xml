<?xml version="1.0" encoding="utf-8"?>
<!-- v21+ branded splash — same dark-navy brand color, consistent across all API levels and OS dark/light modes -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid brand dark-navy background — eliminates white/black flash -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF070F1E"/>
        </shape>
    </item>

    <!-- Centered app icon shown while the Flutter engine warms up -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher"/>
    </item>
</layer-list>
